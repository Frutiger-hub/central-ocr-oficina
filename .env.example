# Caminho local da planilha central XLSM
XLSM_PATH=C:\\Sistema\\PRODUTIVIDADE OFICINA1.xlsm

# Se o Tesseract estiver no PATH, deixe vazio.
# Exemplo Windows:
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

# Guarda cópia dos PDFs enviados localmente
KEEP_UPLOADS=true

# Idioma principal do OCR
OCR_LANG=por
